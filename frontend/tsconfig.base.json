{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "target": "es2022",
    "useDefineForClassFields": false,
    "module": "es2020",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "lib": ["es2020", "dom"]
  }
}
